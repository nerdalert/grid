{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gridNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "gridId": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "swim": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "probeInterval": { "type": "string" },
            "suspicionTimeout": { "type": "string" },
            "gossipNodes": { "type": "integer", "minimum": 1 }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": true
        },
        "routingPolicy": {
          "type": "string",
          "enum": ["geographyFirst", "scoreFirst"]
        },
        "scoringPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["noMetrics", "queueDepth", "kvCachePressure"]
            }
          }
        },
        "selectionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["deterministic", "roundRobin", "random", "weightedRandom"]
            }
          }
        },
        "placementPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["equal", "static", "pressureWeighted"]
            },
            "pressureWeighted": {
              "type": "object",
              "additionalProperties": false,
              "required": ["signal"],
              "properties": {
                "signal": { "type": "string", "enum": ["queueDepth", "kvCachePressure"] },
                "minimumWeight": { "type": "integer", "minimum": 1, "maximum": 1000 },
                "maximumWeight": { "type": "integer", "minimum": 1, "maximum": 1000 },
                "availabilityFloorPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
                "smoothingFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "changeThresholdPercent": { "type": "integer", "minimum": 0, "maximum": 100 }
              }
            }
          }
        },
        "metricsRefreshInterval": {
          "type": "string",
          "pattern": "^([1-9][0-9]*s|[1-9][0-9]{3,}ms)$"
        },
        "budgetPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tenantId", "capUsd"],
                "properties": {
                  "tenantId": { "type": "string", "minLength": 1 },
                  "capUsd": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        "gatewayRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "namespace"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string", "minLength": 1 },
              "localSiteName": { "type": "string" }
            }
          }
        }
      },
      "allOf": [
          {
            "if": {
              "required": ["selectionPolicy"],
              "properties": {
                "selectionPolicy": {
                  "properties": {
                    "mode": { "const": "weightedRandom" }
                  },
                  "required": ["mode"]
                }
              }
            },
            "then": { "required": ["placementPolicy"] }
          },
          {
            "if": { "required": ["placementPolicy"] },
            "then": {
              "properties": {
                "selectionPolicy": {
                  "required": ["mode"],
                  "properties": { "mode": { "const": "weightedRandom" } }
                }
              },
              "required": ["selectionPolicy"]
            }
          },
          {
            "if": {
              "required": ["placementPolicy"],
              "properties": {
                "placementPolicy": {
                  "properties": { "strategy": { "const": "pressureWeighted" } }
                }
              }
            },
            "then": {
              "properties": {
                "placementPolicy": { "required": ["pressureWeighted"] }
              }
            }
          },
          {
            "if": {
              "required": ["placementPolicy"],
              "properties": {
                "placementPolicy": {
                  "properties": {
                    "strategy": { "enum": ["equal", "static"] }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "placementPolicy": {
                  "not": { "required": ["pressureWeighted"] }
                }
              }
            }
          },
          {
            "if": {
              "required": ["placementPolicy"],
              "properties": {
                "placementPolicy": {
                  "properties": {
                    "strategy": { "const": "pressureWeighted" },
                    "pressureWeighted": {
                      "properties": { "signal": { "const": "queueDepth" } }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "scoringPolicy": {
                  "required": ["strategy"],
                  "properties": { "strategy": { "const": "queueDepth" } }
                }
              },
              "required": ["scoringPolicy"]
            }
          },
          {
            "if": {
              "required": ["placementPolicy"],
              "properties": {
                "placementPolicy": {
                  "properties": {
                    "strategy": { "const": "pressureWeighted" },
                    "pressureWeighted": {
                      "properties": { "signal": { "const": "kvCachePressure" } }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "scoringPolicy": {
                  "required": ["strategy"],
                  "properties": { "strategy": { "const": "kvCachePressure" } }
                }
              },
              "required": ["scoringPolicy"]
            }
          }
        ]
    },
    "gridSite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "providerSiteLabel": {
          "type": "string"
        }
      }
    },
    "inferenceProviders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "gridNetworkRef", "providerKind", "backendKind", "endpoint"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "gridNetworkRef": { "type": "string", "minLength": 1 },
          "providerKind": { "type": "string", "minLength": 1 },
          "backendKind": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string", "minLength": 1 },
          "routingClusterRef": { "type": "string" },
          "capacityWeight": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "siteSelector": { "type": "object", "additionalProperties": true },
          "accessPolicy": { "type": "object", "additionalProperties": true },
          "models": { "type": "array" },
          "auth": { "type": "object", "additionalProperties": true },
          "cost": { "type": "object", "additionalProperties": true },
          "healthCheck": { "type": "object", "additionalProperties": true },
          "metricsConfig": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
