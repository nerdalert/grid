{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "pools"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "pullPolicy"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string"}, "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"}, "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}}},
    "backend": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "enum": ["simulator", "vllm"]}, "command": {"type": "array", "items": {"type": "string"}}, "args": {"type": "array", "items": {"type": "string"}}, "env": {"type": "array"}}},
    "model": {"type": "string", "minLength": 1},
    "servedModelName": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["echo"]},
    "forceDummyTokenizer": {"type": "boolean"},
    "maxNumSeqs": {"type": "integer", "minimum": 1},
    "maxWaitingQueueLength": {"type": "integer", "minimum": 1},
    "fakeMetrics": {"type": "object", "additionalProperties": false, "properties": {"runningRequests": {"type": "number", "minimum": 0}, "waitingRequests": {"type": "number", "minimum": 0}, "kvCacheUsage": {"type": "number", "minimum": 0, "maximum": 1}}},
    "pools": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "weight"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$"}, "weight": {"type": "integer", "minimum": 1, "maximum": 1000}}}},
    "service": {"type": "object", "additionalProperties": false, "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "resources": {"type": "object"},
    "gpu": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "resourceName": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 1}}},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "imagePullSecrets": {"type": "array"}
  }
}
